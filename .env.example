# Copy to .env and fill in. Never commit .env.
# Placeholders only: no real secret belongs in this file.

# Postgres 16 + pgvector
# POSTGRES_* configure the postgres container; docker compose derives the api's
# in-network DATABASE_URL from them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=due_diligence
# Host-side URL, used when running the API outside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/due_diligence

# Redis (Celery broker / result backend)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret (generate a long random value per environment)
JWT_SECRET=change-me-generate-a-random-32-byte-hex-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM gateway (LiteLLM, step 2.5). LITELLM_API_KEY is the gateway's own master
# key: the backend sends it as its bearer token. It is not a provider key.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=change-me

# Aliases the backend asks the gateway for. Each must appear as a model_name in
# docker/litellm/config.yaml.
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TRIAGE_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o

# Provider models behind those aliases, read by the gateway container only.
LITELLM_UPSTREAM_DEFAULT_MODEL=openai/gpt-4o-mini
LITELLM_UPSTREAM_FALLBACK_MODEL=openai/gpt-4o
LITELLM_UPSTREAM_BONSAI_MODEL=together_ai/Prism-ML/Ternary-Bonsai-27B
# The provider key. Only the gateway container reads it; never put it in code.
OPENAI_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
# The two keys above are read only when an alias points at those providers.

# Retry, timeout and output limits for model calls.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Embeddings (step 2.3). EMBEDDING_PROVIDER is "hashing" (offline, no key needed)
# or "gateway" (uses LITELLM_BASE_URL and LITELLM_API_KEY).
# EMBEDDING_DIMENSIONS must match the vector(1536) column.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30

# Upload limits (enforced by intake, step 1.2)
MAX_UPLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=524288000
MAX_FILE_COUNT=20000
MAX_COMPRESSION_RATIO=100
MAX_FILE_BYTES=1048576
UPLOAD_DIR=./data/uploads
