# Copy to .env and fill in. Never commit .env.
# Placeholders only: no real secret belongs in this file.

# Postgres 16 + pgvector
# POSTGRES_* configure the postgres container; docker compose derives the api's
# in-network DATABASE_URL from them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=due_diligence
# Host-side URL, used when running the API outside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/due_diligence

# Redis (Celery broker / result backend)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret (generate a long random value per environment)
JWT_SECRET=change-me-generate-a-random-32-byte-hex-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM gateway (LiteLLM, step 2.5). LITELLM_API_KEY is the gateway's own master
# key: the backend sends it as its bearer token. It is not a provider key.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=change-me

# Aliases the backend asks the gateway for. Each must appear as a model_name in
# docker/litellm/config.yaml.
LLM_DEFAULT_MODEL=agent-default
LLM_TRIAGE_MODEL=agent-default
LLM_FALLBACK_MODEL=gpt-4o

# Provider models behind those aliases, read by the gateway container only.
LITELLM_UPSTREAM_DEFAULT_MODEL=openai/gpt-4o-mini
LITELLM_UPSTREAM_FALLBACK_MODEL=openai/gpt-4o
LITELLM_UPSTREAM_BONSAI_MODEL=together_ai/Prism-ML/Ternary-Bonsai-27B
# The provider key. Only the gateway container reads it; never put it in code.
OPENAI_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
# The two keys above are read only when an alias points at those providers.

# Retry, timeout and output limits for model calls.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Embeddings (step 2.3). EMBEDDING_PROVIDER is "hashing" (offline, no key needed)
# or "gateway" (uses LITELLM_BASE_URL and LITELLM_API_KEY).
# EMBEDDING_DIMENSIONS must match the vector(1536) column.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30

# Upload limits (enforced by intake, step 1.2)
MAX_UPLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=524288000
MAX_FILE_COUNT=20000
MAX_COMPRESSION_RATIO=100
MAX_FILE_BYTES=1048576
UPLOAD_DIR=./data/uploads

# Authentication (step 3.6). JWT_SECRET signs access and refresh tokens: generate a
# long random value per environment and never commit it. COOKIE_SECURE must be true
# wherever the browser reaches the API over HTTPS.
JWT_REFRESH_DAYS=14
COOKIE_SECURE=false

# One account per role, created by backend/scripts/seed_users.py. There is no public
# signup, so these are the only credentials that exist. Set them for a deployment,
# run the script, then remove them from the environment.
SEED_ANALYST_EMAIL=
SEED_ANALYST_PASSWORD=
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Langfuse (step 3.8). Self-hosted tracing; the stack brings its own Postgres,
# ClickHouse and MinIO. With LANGFUSE_HOST unset the backend records no traces at all.
# The seed project's keys are fixed defaults for a local stack - use real ones
# anywhere else, and never commit them.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_ADMIN_EMAIL=admin@example.local
LANGFUSE_ADMIN_PASSWORD=langfuse-local-dev
